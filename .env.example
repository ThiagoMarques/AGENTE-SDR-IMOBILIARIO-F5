# Copie para .env e preencha. O .env não é versionado.
DATABASE_URL=postgresql+psycopg://sdr:sdr@localhost:5432/sdr
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
# br = catálogo sintético Brasil (padrão); fake = Fake Real Estate API (EUA)
IMOVEIS_SOURCE=br
# IMOVEIS_API_BASE=https://fakeapifordevs.vercel.app/api/realestate
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# CRM (vazio = desabilitado). Para a demo, suba: python main.py --crm-servidor
CRM_WEBHOOK_URL=http://127.0.0.1:8001/webhook/leads
CRM_WEBHOOK_TOKEN=
CRM_TIMEOUT=3

# Agenda de visitas. Sem credenciais: o lead recebe links Google/Outlook + .ics.
AGENDA_TZ=America/Sao_Paulo
AGENDA_DURACAO_MIN=60
AGENDA_IMOBILIARIA=Imobiliária
AGENDA_CORRETOR_EMAIL=
# Google Agenda (Gmail/Workspace): OAuth "App para computador" no Google Cloud,
# depois rode: python main.py --agenda-auth google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_ID=primary
# Outlook (Outlook.com/Microsoft 365): app no Microsoft Entra com "fluxos de cliente
# público" habilitado e permissão Calendars.ReadWrite; depois: python main.py --agenda-auth outlook
MS_CLIENT_ID=
MS_TENANT=common

# Convite por e-mail (.ics com RSVP) quando a agenda do corretor não convidou o lead.
# Provedor: resend | sendgrid | vazio = usa o que tiver chave. Sem chave: desabilitado.
# Resend sem domínio verificado só entrega para o e-mail dono da conta (ok para demo).
EMAIL_PROVIDER=
EMAIL_FROM=Imobiliária <visitas@seudominio.com.br>
RESEND_API_KEY=
SENDGRID_API_KEY=
